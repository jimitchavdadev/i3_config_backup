# ==============================================================================
#  i3wm Configuration - Replicating dots (Hyprland rice by jimitchavda)
# ==============================================================================

# Include dynamic Wallust generated color palette
include ~/.config/i3/colors.conf

set $mod Mod4

# Font
font pango:JetBrainsMono Nerd Font 10

# Workspace auto back and forth
workspace_auto_back_and_forth yes
floating_modifier $mod
focus_follows_mouse yes
focus_on_window_activation focus
tiling_drag modifier titlebar

# Gaps & Borders
gaps inner 4
gaps outer 8
smart_gaps on
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Theme Colors (Sourced from Wallust via ~/.config/i3/colors)
# class                 border    bground   text    indicator child_border

# ==============================================================================
#  STARTUP APPLICATIONS
# ==============================================================================
exec --no-startup-id systemctl --user unset-environment WAYLAND_DISPLAY
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 || /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
exec_always --no-startup-id ~/.config/i3/scripts/display_manage.sh auto
exec_always --no-startup-id ~/.fehbg || ~/.config/i3/scripts/WallustFeh.sh ~/Pictures/wallpapers/wallpaper.jpeg
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id killall -q picom; sleep 0.2; picom -b
exec --no-startup-id greenclip daemon
exec --no-startup-id ~/.config/i3/scripts/idle_handler.sh
exec --no-startup-id ~/.local/bin/bt-volume-fix.sh
exec --no-startup-id [ -f ~/.cache/i3_saved_session.sh ] && bash ~/.cache/i3_saved_session.sh

# ==============================================================================
#  WINDOW RULES
# ==============================================================================
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="(?i)blueman-manager"] floating enable
for_window [class="(?i)nm-connection-editor"] floating enable
for_window [class="(?i)arandr"] floating enable
for_window [class="(?i)gnome-system-monitor"] floating enable
for_window [class="(?i)swappy"] floating enable
for_window [class="(?i)yad"] floating enable
for_window [title="(?i)KooL Quick Cheat Sheet"] floating enable
for_window [title="(?i)i3wm Quick Cheat Sheet"] floating enable
for_window [instance="dropdown_terminal"] floating enable, resize set 1150 680, move position center, move scratchpad

# ==============================================================================
#  KEYBINDINGS - APPLICATIONS & CORE
# ==============================================================================
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+Shift+Return exec --no-startup-id ~/.config/i3/scripts/Dropterminal.sh
bindsym $mod+d exec --no-startup-id "rofi -show drun -modi drun,filebrowser,run,window"
bindsym $mod+b exec --no-startup-id google-chrome --new-window
bindsym $mod+Shift+b exec --no-startup-id google-chrome --new-window --incognito
bindsym $mod+e exec --no-startup-id thunar --window || nautilus --new-window
bindsym $mod+c exec --no-startup-id code --new-window
bindsym Ctrl+Shift+Escape exec --no-startup-id gnome-system-monitor

# Window Management
bindsym $mod+q kill
bindsym $mod+Shift+q exec --no-startup-id ~/.config/i3/scripts/KillActiveProcess.sh
bindsym $mod+f fullscreen toggle
bindsym $mod+Ctrl+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+g layout toggle tabbed split
bindsym $mod+Shift+i split toggle
bindsym $mod+Mod1+l layout toggle split

# Focus Navigation
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move Containers
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Ctrl+Left move left 40px
bindsym $mod+Ctrl+Down move down 40px
bindsym $mod+Ctrl+Up move up 40px
bindsym $mod+Ctrl+Right move right 40px

bindsym $mod+Mod1+Left move left
bindsym $mod+Mod1+Down move down
bindsym $mod+Mod1+Up move up
bindsym $mod+Mod1+Right move right

# ==============================================================================
#  WORKSPACES
# ==============================================================================
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Workspace Navigation
bindsym $mod+Tab exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh next
bindsym $mod+Shift+Tab exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh prev
bindsym $mod+grave exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh prev
bindsym $mod+Shift+grave exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh next
bindsym $mod+a exec --no-startup-id ~/.config/i3/scripts/OverviewToggle.sh
bindsym $mod+period exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh next
bindsym $mod+comma exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh prev
bindsym $mod+bracketright exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh next
bindsym $mod+bracketleft exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh prev
bindsym $mod+Shift+bracketright move container to workspace next
bindsym $mod+Shift+bracketleft move container to workspace prev

# Multi-Monitor Display Movement
bindsym $mod+Ctrl+o move workspace to output next
bindsym $mod+Ctrl+Shift+o move container to output next
bindsym $mod+Ctrl+F9 move workspace to output left
bindsym $mod+Ctrl+F10 move workspace to output right

# Scratchpad
bindsym $mod+u [instance="dropdown_terminal"] scratchpad show
bindsym $mod+Shift+u move scratchpad

# Mouse Bindings for Workspace Switching
bindsym --whole-window $mod+button4 exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh prev
bindsym --whole-window $mod+button5 exec --no-startup-id ~/.config/i3/scripts/workspace_cycle.sh next

# Resize Mode
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ==============================================================================
#  MEDIA & HARDWARE CONTROLS
# ==============================================================================
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/Volume.sh --inc
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/Volume.sh --dec
bindsym Mod1+XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/Volume.sh --inc-precise
bindsym Mod1+XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/Volume.sh --dec-precise
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/Volume.sh --toggle
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/scripts/Volume.sh --toggle-mic

bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/Brightness.sh --inc
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/Brightness.sh --dec

bindsym XF86AudioPlay exec --no-startup-id ~/.config/i3/scripts/MediaCtrl.sh --pause
bindsym XF86AudioPause exec --no-startup-id ~/.config/i3/scripts/MediaCtrl.sh --pause
bindsym XF86AudioNext exec --no-startup-id ~/.config/i3/scripts/MediaCtrl.sh --nxt
bindsym XF86AudioPrev exec --no-startup-id ~/.config/i3/scripts/MediaCtrl.sh --prv
bindsym XF86AudioStop exec --no-startup-id ~/.config/i3/scripts/MediaCtrl.sh --stop

bindsym XF86RFKill exec --no-startup-id ~/.config/i3/scripts/AirplaneMode.sh
bindsym XF86WLAN exec --no-startup-id ~/.config/i3/scripts/AirplaneMode.sh
bindsym XF86Sleep exec --no-startup-id systemctl suspend

# ==============================================================================
#  SCREENSHOTS
# ==============================================================================
bindsym Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --now
bindsym $mod+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --now
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --area
bindsym $mod+Shift+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --area
bindsym $mod+Ctrl+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --in5
bindsym $mod+Ctrl+Shift+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --in10
bindsym Mod1+Print exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --active
bindsym $mod+Shift+s exec --no-startup-id ~/.config/i3/scripts/ScreenShot.sh --swappy

# ==============================================================================
#  POWER & LOCK SCREEN
# ==============================================================================
bindsym $mod+l exec --no-startup-id ~/.config/i3/scripts/LockScreen.sh
bindsym Ctrl+Mod1+l exec --no-startup-id ~/.config/i3/scripts/LockScreen.sh
bindsym Ctrl+Mod1+p exec --no-startup-id ~/.config/i3/scripts/Wlogout.sh
bindsym Ctrl+Mod1+Delete exec --no-startup-id ~/.config/i3/scripts/SaveSession.sh poweroff
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/Kool_Quick_Settings.sh

# ==============================================================================
#  ROFI MENUS & CUSTOM SCRIPTS
# ==============================================================================
bindsym $mod+w exec --no-startup-id ~/.config/i3/scripts/WallpaperSelect.sh
bindsym $mod+Shift+w exec --no-startup-id ~/.config/i3/scripts/WallpaperEffects.sh
bindsym Ctrl+Mod1+w exec --no-startup-id ~/.config/i3/scripts/WallpaperRandom.sh
bindsym $mod+t exec --no-startup-id ~/.config/i3/scripts/ThemeChanger.sh
bindsym $mod+s exec --no-startup-id ~/.config/i3/scripts/RofiSearch.sh
bindsym $mod+Ctrl+s exec --no-startup-id rofi -show window
bindsym $mod+Mod1+v exec --no-startup-id ~/.config/i3/scripts/ClipManager.sh
bindsym $mod+Mod1+e exec --no-startup-id ~/.config/i3/scripts/RofiEmoji.sh
bindsym $mod+Mod1+c exec --no-startup-id ~/.config/i3/scripts/RofiCalc.sh
bindsym $mod+Shift+m exec --no-startup-id ~/.config/i3/scripts/RofiBeats.sh
bindsym $mod+h exec --no-startup-id ~/.config/i3/scripts/KeyHints.sh
bindsym $mod+Shift+k exec --no-startup-id ~/.config/i3/scripts/KeyBinds.sh
bindsym $mod+Ctrl+r exec --no-startup-id ~/.config/i3/scripts/RofiThemeSelector.sh
bindsym $mod+Shift+o exec --no-startup-id ~/.config/i3/scripts/ZshChangeTheme.sh

# Bar, Notifications & Night Light
bindsym $mod+Ctrl+Mod1+b exec --no-startup-id polybar-msg cmd toggle
bindsym $mod+Ctrl+b exec --no-startup-id ~/.config/polybar/launch.sh
bindsym $mod+Shift+n exec --no-startup-id ~/.config/i3/scripts/notification_center.sh
bindsym $mod+n exec --no-startup-id ~/.config/i3/scripts/Hyprsunset.sh toggle

# Visual Effects & Compositor Controls
bindsym $mod+Shift+g exec --no-startup-id ~/.config/i3/scripts/GameMode.sh
bindsym $mod+Mod1+o exec --no-startup-id ~/.config/i3/scripts/ChangeBlur.sh
bindsym $mod+Shift+a exec --no-startup-id ~/.config/i3/scripts/Animations.sh
bindsym $mod+Mod1+r exec --no-startup-id ~/.config/i3/scripts/Refresh.sh
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+p exec --no-startup-id ~/.config/i3/scripts/MonitorProfiles.sh
bindsym $mod+Shift+d exec --no-startup-id arandr
