#!/usr/bin/env bash
# Autorandr Global Post-Switch Hook for i3 & Polybar
set -euo pipefail

# Ensure DISPLAY and XAUTHORITY are set if run from systemd / udev
export DISPLAY="${DISPLAY:-:0}"
if [[ -z "${XAUTHORITY:-}" ]]; then
    export XAUTHORITY="/run/user/$(id -u)/gdm/Xauthority"
    if [[ ! -f "$XAUTHORITY" ]]; then
        export XAUTHORITY="$HOME/.Xauthority"
    fi
fi

# Detect primary and active outputs
PRIMARY=$(xrandr --query 2>/dev/null | grep " connected primary" | cut -d" " -f1 || true)
if [[ -z "$PRIMARY" ]]; then
    PRIMARY=$(xrandr --query 2>/dev/null | grep " connected" | head -n 1 | cut -d" " -f1 || echo "eDP-1")
fi

active_outputs=$(i3-msg -t get_outputs 2>/dev/null | jq -r '.[] | select(.active == true) | .name' || true)

# Migrate any orphaned workspaces from inactive/disconnected outputs to primary output
if [[ -n "$active_outputs" && -n "$PRIMARY" ]]; then
    act_json=$(printf '%s\n' "$active_outputs" | jq -R . | jq -s .)
    orphans=$(i3-msg -t get_workspaces 2>/dev/null | jq -r --argjson act "$act_json" '.[] | select(.output as $o | ($act | index($o)) == null) | .name' || true)
    for ws in $orphans; do
        i3-msg "workspace $ws, move workspace to output $PRIMARY" >/dev/null 2>&1 || true
    done
fi

# Reload i3 cleanly without dropping IPC connections
i3-msg reload >/dev/null 2>&1 || true

# Reload Polybar and Wallpaper via i3 session daemon (escapes systemd service cgroups)
if ! i3-msg "exec --no-startup-id $HOME/.config/polybar/launch.sh" >/dev/null 2>&1; then
    nohup "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
fi
if ! i3-msg "exec --no-startup-id $HOME/.config/i3/scripts/WallustFeh.sh" >/dev/null 2>&1; then
    nohup "$HOME/.config/i3/scripts/WallustFeh.sh" >/dev/null 2>&1 &
fi

# Desktop notification
profile_name="${AUTORANDR_CURRENT_PROFILE:-default}"
notify-send -i "$HOME/.config/swaync/images/ja.png" "Display" "Profile loaded: $profile_name" 2>/dev/null || true
